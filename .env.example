# ============================================================
# Configuración de Cine Atlántico
# Copia este archivo con el nombre .env (ver README, Paso 5).
# Los valores de abajo funcionan tal cual con docker compose.
# ============================================================

# --- Servicio de boletos (página web y API REST) ---
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/cine
# Clave del panel de Administración
ADMIN_KEY=admin123

# --- RabbitMQ (mensajería entre microservicios) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Servicio de notificaciones (correos con los boletos) ---
# Mailpit es un buzón de prueba: los correos se ven en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
CORREO_REMITENTE=Cine Atlántico <boletos@cine-atlantico.local>

# --- Servicio de reportes (estadísticas) ---
REPORTES_PORT=3002
REPORTES_MONGODB_URI=mongodb://127.0.0.1:27017/cine_reportes
REPORTES_URL=http://localhost:3002
